# --- Archivos de Entorno y Secretos (CRÍTICO) ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx

# --- Bases de Datos y Almacenamiento Local ---
*.db
*.sqlite
*.sqlite3
backend/tgs_hub.db
backend/uploads/
uploads/

# --- Python / Backend ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Entornos virtuales de Python
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing y Cobertura (Python)
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# --- Node / Frontend ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Builds de frontend
frontend/dist/
frontend/dist-ssr/
dist/
*.local

# Cachés de herramientas frontend
.eslintcache
.stylelintcache
*.tsbuildinfo
.vite/

# --- IDEs y Editores del Sistema ---
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# Metadatos del Sistema Operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Logs generales y temporales
*.log
logs/
temp/
tmp/
